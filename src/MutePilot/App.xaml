<Application x:Class="MutePilot.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MutePilot"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#111318" />
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#1A1D24" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#2A2F3A" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F3F4F6" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#9CA3AF" />
    </Application.Resources>
</Application>
