<Window x:Class="MutePilot.HotkeyCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="전역 단축키 입력"
        Width="430" Height="270" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock FontSize="19" FontWeight="SemiBold" Text="단축키를 눌러 주세요" />
            <TextBlock Margin="0,8,0,0" Foreground="{StaticResource SecondaryTextBrush}"
                       Text="F1~F11 또는 Ctrl/Alt/Shift와 영문·숫자 키 조합을 사용할 수 있습니다."
                       TextWrapping="Wrap" />
        </StackPanel>
        <Border Grid.Row="1" Margin="0,18" Padding="14"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1" CornerRadius="6">
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="CapturedHotkeyText" HorizontalAlignment="Center"
                           FontSize="20" FontWeight="SemiBold" Text="키 입력 대기 중" />
                <TextBlock x:Name="CaptureErrorText" Margin="0,8,0,0"
                           HorizontalAlignment="Center" Foreground="#FCA5A5"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="2" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Width="82" Height="32" Click="CancelButton_Click" Content="취소" />
            <Button x:Name="SaveButton" Width="82" Height="32" Margin="8,0,0,0"
                    Click="SaveButton_Click" Content="저장" IsEnabled="False" />
        </StackPanel>
    </Grid>
</Window>
