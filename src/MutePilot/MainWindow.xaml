<Window x:Class="MutePilot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MutePilot" Width="820" Height="940" MinWidth="720" MinHeight="760"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}"
        Loaded="MainWindow_Loaded">
    <Grid Margin="28,24,28,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontSize="28" FontWeight="SemiBold" Text="MutePilot" />
                <TextBlock Margin="0,6,0,0" FontSize="13"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Text="Custom hotkey-based Windows audio control" />
            </StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                <TextBlock HorizontalAlignment="Center" FontSize="12"
                           Foreground="{StaticResource SecondaryTextBrush}" Text="오버레이" />
                <Button x:Name="OverlayToggleButton" Width="74" Height="30" Margin="0,6,0,0"
                        Click="OverlayToggleButton_Click" Content="ON" />
                <Button x:Name="OverlayPositionResetButton" Width="124" Height="28" Margin="0,6,0,0"
                        Click="OverlayPositionResetButton_Click" Content="오버레이 위치 초기화" />
            </StackPanel>
            <TextBlock x:Name="HotkeyErrorText" Grid.Row="1" Grid.ColumnSpan="2"
                       Margin="0,10,0,0" FontSize="12" Foreground="#FCA5A5"
                       TextWrapping="Wrap" Visibility="Collapsed" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,6,0">
                <Border Padding="18" Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="300" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="17" FontWeight="SemiBold" Text="Master Audio" />
                            <TextBlock x:Name="MasterAudioStatusText" Margin="0,8,0,0" FontSize="13"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Text="현재 상태: 확인 중" TextWrapping="Wrap" />
                            <TextBlock x:Name="MasterVolumeStatusText" Margin="0,5,0,10" FontSize="13"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Text="현재 볼륨: 확인 중" TextWrapping="Wrap" />
                            <Button x:Name="MasterMuteButton" Width="160" Height="32"
                                    HorizontalAlignment="Left" Click="MasterMuteButton_Click"
                                    Content="상태 확인 중" IsEnabled="False" />
                            <TextBlock x:Name="AudioErrorText" Margin="0,12,0,0" FontSize="12"
                                       Foreground="#FCA5A5" TextWrapping="Wrap" Visibility="Collapsed" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="24,0,0,0">
                            <TextBlock FontWeight="SemiBold" Text="음소거 단축키" />
                            <TextBlock x:Name="MasterHotkeyText" Margin="0,4,0,0"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Text="설정 안 됨" TextWrapping="Wrap" />
                            <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                                <Button x:Name="MasterHotkeyButton" Width="104" Height="32"
                                        Click="MasterHotkeyButton_Click" Content="단축키 설정" />
                                <Button x:Name="MasterHotkeyRemoveButton" Width="82" Height="32"
                                        Margin="8,0,0,0" Click="MasterHotkeyRemoveButton_Click"
                                        Content="삭제" Visibility="Collapsed" />
                            </StackPanel>
                            <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="볼륨 프리셋" />
                            <TextBlock Margin="0,3,0,0" FontSize="11"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Text="기본 볼륨은 프리셋을 적용하기 직전의 소리 상태입니다."
                                       TextWrapping="Wrap" />
                            <Grid Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="44" />
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="MasterVolumeSlider" Minimum="1" Maximum="100"
                                        TickFrequency="1" IsSnapToTickEnabled="True"
                                        ValueChanged="MasterVolumeSlider_ValueChanged" />
                                <TextBlock x:Name="MasterVolumePresetText" Grid.Column="1"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" Text="50%" />
                            </Grid>
                            <TextBlock x:Name="MasterVolumeHotkeyText" Margin="0,6,0,0"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Text="볼륨 단축키: 설정 안 됨" TextWrapping="Wrap" />
                            <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                                <Button x:Name="MasterVolumeHotkeyButton" Width="104" Height="32"
                                        Click="MasterVolumeHotkeyButton_Click" Content="단축키 설정" />
                                <Button x:Name="MasterVolumeHotkeyRemoveButton" Width="82" Height="32"
                                        Margin="8,0,0,0" Click="MasterVolumeHotkeyRemoveButton_Click"
                                        Content="삭제" Visibility="Collapsed" />
                            </StackPanel>
                            <Button x:Name="MasterVolumeApplyButton" Height="32" Margin="0,8,0,0"
                                    Click="MasterVolumeApplyButton_Click" Content="50%로 전환" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Margin="0,16,0,0" Padding="18"
                        Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="300" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock FontSize="17" FontWeight="SemiBold" Text="실행 설정" />
                            <TextBlock Margin="0,7,0,0" FontSize="12"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Text="관리자 권한으로 실행되는 프로그램에서 사용자 지정 단독 키를 사용하려면 MutePilot도 관리자 권한이 필요할 수 있습니다."
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="StartupDetailText" Margin="0,6,0,0" FontSize="11"
                                       Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                            <TextBlock x:Name="StartupErrorText" Margin="0,7,0,0" FontSize="12"
                                       Foreground="#FCA5A5" TextWrapping="Wrap" Visibility="Collapsed" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center"
                                           Text="Windows 로그인 시 MutePilot 자동 실행" TextWrapping="Wrap" />
                                <Button x:Name="StartupToggleButton" Grid.Column="1" Width="60" Height="30"
                                        Margin="10,0,0,0" Click="StartupToggleButton_Click"
                                        Content="확인 중" IsEnabled="False" />
                            </Grid>
                            <TextBlock x:Name="PrivilegeStatusText" Margin="0,10,0,0"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Text="현재 실행 권한: 확인 중" />
                            <Button x:Name="RestartAsAdministratorButton" Height="32" Margin="0,8,0,0"
                                    Click="RestartAsAdministratorButton_Click"
                                    Content="MutePilot을 관리자 권한으로 재시작" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Margin="0,16,0,0" Padding="18"
                        Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="17" FontWeight="SemiBold" Text="Applications" />
                                <TextBlock Margin="0,5,12,0" FontSize="12"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           Text="활성 오디오 세션과 저장된 음소거·볼륨 프리셋" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button x:Name="ApplicationRefreshButton" Grid.Column="1" Width="84" Height="30"
                                    VerticalAlignment="Top" Click="ApplicationRefreshButton_Click" Content="새로고침" />
                        </Grid>
                        <TextBlock x:Name="ApplicationErrorText" Margin="0,12,0,0" FontSize="12"
                                   Foreground="#FCA5A5" TextWrapping="Wrap" Visibility="Collapsed" />
                        <TextBlock x:Name="ApplicationEmptyText" Padding="0,14"
                                   HorizontalAlignment="Center" FontSize="13"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Text="활성 세션이나 저장된 앱 설정이 없습니다." Visibility="Collapsed" />
                        <ItemsControl x:Name="ApplicationsItemsControl" Margin="0,14,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,10" Padding="12" Background="#222630"
                                            BorderBrush="{StaticResource PanelBorderBrush}"
                                            BorderThickness="1" CornerRadius="6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock FontSize="14" FontWeight="SemiBold"
                                                           Text="{Binding ApplicationName}" />
                                                <TextBlock Margin="0,5,12,0" FontSize="11"
                                                           Foreground="{StaticResource SecondaryTextBrush}"
                                                           Text="{Binding ProcessIdText}" TextWrapping="Wrap" />
                                                <TextBlock Margin="0,4,12,0" FontSize="12"
                                                           Foreground="{StaticResource SecondaryTextBrush}"
                                                           Text="{Binding StatusText}" />
                                                <TextBlock Margin="0,4,12,0" FontSize="12"
                                                           Foreground="{StaticResource SecondaryTextBrush}"
                                                           Text="{Binding VolumeText}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="92" />
                                                        <ColumnDefinition Width="64" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock FontWeight="SemiBold" Text="음소거 단축키" />
                                                        <TextBlock Margin="0,3,8,0" FontSize="12"
                                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                                   Text="{Binding MuteHotkeyText}" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Height="30" Margin="6,0,0,0"
                                                            Click="ApplicationHotkeyButton_Click"
                                                            Content="{Binding MuteHotkeyButtonText}"
                                                            Tag="{Binding ApplicationKey}" />
                                                    <Button Grid.Column="2" Height="30" Margin="6,0,0,0"
                                                            Click="ApplicationHotkeyRemoveButton_Click"
                                                            Content="삭제" Tag="{Binding ApplicationKey}"
                                                            Visibility="{Binding MuteRemoveButtonVisibility}" />
                                                </Grid>
                                                <Grid Margin="0,9,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="92" />
                                                        <ColumnDefinition Width="64" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock FontWeight="SemiBold" Text="볼륨 단축키" />
                                                        <TextBlock Margin="0,3,8,0" FontSize="12"
                                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                                   Text="{Binding VolumeHotkeyText}" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Height="30" Margin="6,0,0,0"
                                                            Click="ApplicationVolumeHotkeyButton_Click"
                                                            Content="{Binding VolumeHotkeyButtonText}"
                                                            Tag="{Binding ApplicationKey}" />
                                                    <Button Grid.Column="2" Height="30" Margin="6,0,0,0"
                                                            Click="ApplicationVolumeHotkeyRemoveButton_Click"
                                                            Content="삭제" Tag="{Binding ApplicationKey}"
                                                            Visibility="{Binding VolumeRemoveButtonVisibility}" />
                                                </Grid>
                                                <Grid Margin="0,9,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="48" />
                                                        <ColumnDefinition Width="92" />
                                                    </Grid.ColumnDefinitions>
                                                    <Slider x:Name="ApplicationVolumeSlider"
                                                            Minimum="1" Maximum="100" TickFrequency="1"
                                                            IsSnapToTickEnabled="True"
                                                            Value="{Binding VolumePercent, Mode=OneWay}"
                                                            ValueChanged="ApplicationVolumeSlider_ValueChanged"
                                                            Tag="{Binding ApplicationKey}" />
                                                    <TextBlock Grid.Column="1" Margin="6,0,0,0"
                                                               VerticalAlignment="Center"
                                                               Text="{Binding Value, ElementName=ApplicationVolumeSlider,
                                                                              StringFormat={}{0:0}%}" />
                                                    <Button Grid.Column="2" Height="30" Margin="6,0,0,0"
                                                            Click="ApplicationVolumeApplyButton_Click"
                                                            Content="{Binding VolumeToggleButtonText}"
                                                            IsEnabled="{Binding IsRunning}"
                                                            Tag="{Binding ApplicationKey}" />
                                                </Grid>
                                                <Button Height="30" Margin="0,9,0,0"
                                                        Click="ApplicationMuteButton_Click"
                                                        Content="{Binding ToggleButtonText}"
                                                        IsEnabled="{Binding IsRunning}"
                                                        Tag="{Binding ApplicationKey}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="2" Margin="0,18,0,0" HorizontalAlignment="Center"
                   FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"
                   Text="Made by 유성우" />
    </Grid>
</Window>
