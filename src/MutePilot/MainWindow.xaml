<Window x:Class="MutePilot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MutePilot" Width="760" Height="820" MinWidth="650" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}"
        Loaded="MainWindow_Loaded">
    <Grid Margin="28,24,28,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,22">
            <TextBlock FontSize="28" FontWeight="SemiBold" Text="MutePilot" />
            <TextBlock Margin="0,6,0,0" FontSize="13"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="Custom hotkey-based Windows audio muting" />
            <TextBlock x:Name="HotkeyErrorText" Margin="0,10,0,0" FontSize="12"
                       Foreground="#FCA5A5" TextWrapping="Wrap" Visibility="Collapsed" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="18" Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="Master Audio" />
                        <TextBlock x:Name="MasterAudioStatusText" Margin="0,8,0,10" FontSize="13"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Text="현재 상태: 확인 중" TextWrapping="Wrap" />
                        <Button x:Name="MasterMuteButton" Width="160" Height="32"
                                HorizontalAlignment="Left" Click="MasterMuteButton_Click"
                                Content="상태 확인 중" IsEnabled="False" />
                        <TextBlock x:Name="AudioErrorText" Margin="0,12,0,0" FontSize="12"
                                   Foreground="#FCA5A5" TextWrapping="Wrap" Visibility="Collapsed" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Width="210" Margin="24,0,0,0">
                        <TextBlock x:Name="MasterHotkeyText"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Text="단축키: 설정 안 됨" TextWrapping="Wrap" />
                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                            <Button x:Name="MasterHotkeyButton" Width="104" Height="32"
                                    Click="MasterHotkeyButton_Click" Content="단축키 설정" />
                            <Button x:Name="MasterHotkeyRemoveButton" Width="82" Height="32"
                                    Margin="8,0,0,0" Click="MasterHotkeyRemoveButton_Click"
                                    Content="삭제" Visibility="Collapsed" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Margin="0,16,0,0" Padding="18"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="17" FontWeight="SemiBold" Text="Applications" />
                            <TextBlock Margin="0,5,12,0" FontSize="12"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Text="활성 오디오 세션과 저장된 앱 단축키" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button x:Name="ApplicationRefreshButton" Grid.Column="1" Width="84" Height="30"
                                VerticalAlignment="Top" Click="ApplicationRefreshButton_Click" Content="새로고침" />
                    </Grid>
                    <TextBlock x:Name="ApplicationErrorText" Grid.Row="1" Margin="0,12,0,0"
                               FontSize="12" Foreground="#FCA5A5" TextWrapping="Wrap" Visibility="Collapsed" />
                    <ScrollViewer Grid.Row="2" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="ApplicationEmptyText" Padding="0,14"
                                       HorizontalAlignment="Center" FontSize="13"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Text="활성 세션이나 저장된 앱 단축키가 없습니다."
                                       Visibility="Collapsed" />
                            <ItemsControl x:Name="ApplicationsItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,10" Padding="12" Background="#222630"
                                                BorderBrush="{StaticResource PanelBorderBrush}"
                                                BorderThickness="1" CornerRadius="6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock FontSize="14" FontWeight="SemiBold"
                                                               Text="{Binding ApplicationName}" />
                                                    <TextBlock Margin="0,5,12,0" FontSize="11"
                                                               Foreground="{StaticResource SecondaryTextBrush}"
                                                               Text="{Binding ProcessIdText}" TextWrapping="Wrap" />
                                                    <TextBlock Margin="0,4,12,0" FontSize="12"
                                                               Foreground="{StaticResource SecondaryTextBrush}"
                                                               Text="{Binding StatusText}" />
                                                    <TextBlock Margin="0,4,12,0" FontSize="12"
                                                               Foreground="{StaticResource SecondaryTextBrush}"
                                                               Text="{Binding HotkeyText}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Width="104" Margin="12,0,0,0">
                                                    <Button Height="30" Click="ApplicationMuteButton_Click"
                                                            Content="{Binding ToggleButtonText}"
                                                            IsEnabled="{Binding IsRunning}"
                                                            Tag="{Binding ApplicationKey}" />
                                                    <Button Height="30" Margin="0,7,0,0"
                                                            Click="ApplicationHotkeyButton_Click"
                                                            Content="{Binding HotkeyButtonText}"
                                                            Tag="{Binding ApplicationKey}" />
                                                    <Button Height="30" Margin="0,7,0,0"
                                                            Click="ApplicationHotkeyRemoveButton_Click"
                                                            Content="단축키 삭제" Tag="{Binding ApplicationKey}"
                                                            Visibility="{Binding RemoveButtonVisibility}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" Margin="0,18,0,0" HorizontalAlignment="Center"
                   FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"
                   Text="Made by 유성우" />
    </Grid>
</Window>
