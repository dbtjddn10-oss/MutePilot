<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Product>MutePilot</Product>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.3.0" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

  <PropertyGroup Condition="Exists('Assets\app-icon.ico')">
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup Condition="Exists('Assets\app-icon.ico')">
    <None Remove="Assets\app-icon.ico" />
    <Resource Include="Assets\app-icon.ico" />
  </ItemGroup>

  <ItemGroup Condition="Exists('Assets\brand-icon.png')">
    <None Remove="Assets\brand-icon.png" />
    <Resource Include="Assets\brand-icon.png" />
  </ItemGroup>

  <ItemGroup Condition="Exists('Assets\brand-icon-small.png')">
    <None Remove="Assets\brand-icon-small.png" />
    <Resource Include="Assets\brand-icon-small.png" />
  </ItemGroup>

  <ItemGroup Condition="Exists('Assets\toss-support-qr.jpg')">
    <None Remove="Assets\toss-support-qr.jpg" />
    <Resource Include="Assets\toss-support-qr.jpg" />
  </ItemGroup>

</Project>
