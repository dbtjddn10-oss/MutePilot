<Window x:Class="MutePilot.Overlay.MuteOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MutePilot Overlay"
        Width="252"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        AllowsTransparency="True"
        Background="Transparent"
        LocationChanged="Window_LocationChanged">
    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Border x:Name="HudCard"
                    Padding="9,7,9,8"
                    Background="#FF171A20"
                    BorderBrush="#343A46"
                    BorderThickness="1"
                    CornerRadius="7">
                <StackPanel>
                    <Grid Height="20" Margin="2,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="22" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <TextBlock VerticalAlignment="Center"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="#AEB6C4"
                                       Text="MutePilot" />
                            <Thumb x:Name="DragSurface"
                                   Background="Transparent"
                                   Cursor="Arrow"
                                   Focusable="False"
                                   DragDelta="DragSurface_DragDelta"
                                   DragCompleted="DragSurface_DragCompleted">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Grid>
                        <Button x:Name="HeaderLockButton" Grid.Column="1"
                                Width="20" Height="18" Margin="0,0,2,0" Padding="0"
                                BorderThickness="0" Background="#303641" Foreground="#E5E7EB"
                                Focusable="False" FontFamily="Segoe UI Emoji" FontSize="9"
                                Click="LockButton_Click" Content="🔒" ToolTip="오버레이 잠금 해제" />
                        <Button x:Name="CloseButton" Grid.Column="2"
                                Width="20" Height="18" Padding="0" BorderThickness="0"
                                Background="#303641" Foreground="#E5E7EB" Focusable="False"
                                FontSize="13" Click="CloseButton_Click" Content="×"
                                ToolTip="오버레이 끄기" />
                    </Grid>
                    <Border Height="1" Margin="0,0,0,3" Background="#303641" />
                    <ItemsControl x:Name="TargetItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="23">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Margin="2,0,8,0"
                                               VerticalAlignment="Center"
                                               FontSize="11"
                                               Foreground="#EEF1F5"
                                               Opacity="{Binding Opacity}"
                                               Text="{Binding Name}"
                                               TextTrimming="CharacterEllipsis" />
                                    <Button Grid.Column="1" Width="22" Height="20" Padding="0"
                                            BorderThickness="0" Background="#303641"
                                            Foreground="{Binding StatusBrush}" Focusable="False"
                                            FontFamily="Segoe UI Emoji" FontSize="10.5"
                                            Click="AudioToggleButton_Click"
                                            Content="{Binding ToggleGlyph}"
                                            IsEnabled="{Binding CanToggle}"
                                            Tag="{Binding TargetId}"
                                            ToolTip="음소거 상태 전환" />
                                    <TextBlock Grid.Column="2"
                                               VerticalAlignment="Center"
                                               FontSize="10.5"
                                               Foreground="{Binding StatusBrush}"
                                               Opacity="{Binding Opacity}"
                                               Text="{Binding StatusText}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </Grid>

        <Border x:Name="ConfigurationPanel"
                Grid.Row="1"
                Margin="0,3,0,0"
                Padding="8,5"
                Background="#F3232730"
                BorderBrush="#343A46"
                BorderThickness="1"
                CornerRadius="6"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="36" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center"
                           FontSize="10"
                           Foreground="#C7CDD8"
                           Text="투명도" />
                <Slider x:Name="OpacitySlider"
                        Grid.Column="1"
                        Height="18"
                        Margin="8,0,5,0"
                        VerticalAlignment="Center"
                        Focusable="False"
                        Minimum="20"
                        Maximum="100"
                        Value="100"
                        ValueChanged="OpacitySlider_ValueChanged" />
                <TextBlock x:Name="OpacityValueText"
                           Grid.Column="2"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           FontSize="10"
                           Foreground="#C7CDD8"
                           Text="100%" />
            </Grid>
        </Border>
    </Grid>
</Window>
