<Window x:Class="MutePilot.Overlay.MuteOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MutePilot Overlay"
        Width="300" Height="126"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        AllowsTransparency="True"
        Background="Transparent">
    <Border Margin="8"
            Padding="16,13"
            Background="#F21A1D24"
            BorderBrush="#3A4250"
            BorderThickness="1"
            CornerRadius="10">
        <Grid IsHitTestVisible="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="StateIconText"
                       Grid.Column="0"
                       Width="48"
                       Margin="0,0,12,0"
                       VerticalAlignment="Center"
                       FontFamily="Segoe UI Emoji"
                       FontSize="30"
                       Text="🔇"
                       TextAlignment="Center" />

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock FontSize="11"
                           Foreground="#9CA3AF"
                           Text="MutePilot" />
                <TextBlock x:Name="TargetNameText"
                           Margin="0,3,0,0"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#F3F4F6"
                           Text="Master Audio"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="StateText"
                           Margin="0,3,0,0"
                           FontSize="13"
                           Foreground="#D1D5DB"
                           Text="음소거" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
