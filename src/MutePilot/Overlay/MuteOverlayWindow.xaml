<Window x:Class="MutePilot.Overlay.MuteOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MutePilot Overlay"
        Width="226"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        AllowsTransparency="True"
        Background="Transparent">
    <Border Margin="4"
            Padding="9,7,9,8"
            Background="#EC171A20"
            BorderBrush="#343A46"
            BorderThickness="1"
            CornerRadius="7">
        <StackPanel IsHitTestVisible="False">
            <TextBlock Margin="2,0,0,5"
                       FontSize="10"
                       FontWeight="SemiBold"
                       Foreground="#AEB6C4"
                       Text="MutePilot" />
            <Border Height="1" Margin="0,0,0,3" Background="#303641" />
            <ItemsControl x:Name="TargetItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="23">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Margin="2,0,8,0"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       Foreground="#EEF1F5"
                                       Opacity="{Binding Opacity}"
                                       Text="{Binding Name}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe UI, Segoe UI Emoji"
                                       FontSize="10.5"
                                       Foreground="{Binding StatusBrush}"
                                       Opacity="{Binding Opacity}"
                                       Text="{Binding StatusText}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</Window>
